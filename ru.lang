stalker.gui.arcades.results.breakthrough.splash.defenders.win.desc=ОСТАЛОСЬ ТОЛЬКО ДОЖДАТЬСЯ ПОДКРЕПЛЕНИЯ!
stalker.gui.arcades.results.breakthrough.splash.defenders.loss=ЭТО ПРОВАЛ!
